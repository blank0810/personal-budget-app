# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. Nothing here is a real credential.
#   cp .env.example .env
# Grouped: REQUIRED first, then per-feature and optional.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ REQUIRED — the app will not start, or will misbehave, without these ═══

# Local PostgreSQL, created by docker-compose. Any values work for local dev.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=budget_planner

# Prisma's connection string. Correct as-is for local Docker; point it at your
# hosted database in production.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}"

# NextAuth. Generate the secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=

# Public base URL used in emails, PDFs and canonical/SEO tags. Must be the real
# origin in production, or invoice and unsubscribe links point at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encrypts the email provider credentials stored in email_provider_configs.
# It cannot live in the table it protects, so it belongs here.
# Generate with: openssl rand -base64 32
# Rotating it makes every stored provider config unreadable — re-enter them
# under Admin -> System afterwards.
SECRET_ENCRYPTION_KEY=

# Redis, backing the BullMQ monthly-report queue.
REDIS_URL=redis://redis:6379

# Shared secret for /api/cron/* so only your scheduler can invoke them.
# Generate with: openssl rand -hex 32
CRON_SECRET=


# ═══ EMAIL ═══
#
# The Resend API key and sender identity are NOT set here. They are entered in
# the app under Admin -> System and stored encrypted, so they can be rotated
# without a redeploy. RESEND_API_KEY and EMAIL_FROM in the environment are
# deliberately ignored — see server/modules/email/email.config.test.ts.

# Daily send budget, and how much of it is reserved for transactional mail
# (password resets, invoices) so digests cannot starve it.
# Defaults match the Resend free tier.
EMAIL_DAILY_LIMIT=100
EMAIL_DAILY_RESERVE=40

# Fallback recipient for feature-request notifications, used only when the
# admin_notification_email system setting is empty. Optional.
ADMIN_NOTIFICATION_EMAIL=


# ═══ GOOGLE SIGN-IN — optional ═══
#
# Omit both and the app still runs; only "Sign in with Google" stops working.
# Credentials: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ═══ PDF STORAGE — required for monthly report PDFs ═══
#
# Vercel Blob, used by server/modules/report/report.service.ts to store
# generated report PDFs. Monthly reports fail without it; nothing else does.
# Create at: Vercel dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=


# ═══ INVOICE ZIP EXPORT — not wired up yet ═══
#
# Trigger.dev runs the bulk invoice PDF render off Vercel, whose functions cap
# at 60s on the free tier. Create a project at trigger.dev; the project ref goes
# in trigger.config.ts and only the secret belongs here.
# Leave blank until that feature lands — nothing else depends on it.
TRIGGER_SECRET_KEY=


# ═══ SMS NOTIFICATIONS — declared but not implemented ═══
#
# docker-compose forwards these to the container, and the schema has
# smsEnabled notification preferences plus User.phoneNumber, but no code reads
# them yet — nothing sends an SMS. Leave blank; they are here so the compose
# interpolation resolves and so you know they are not a missing dependency.
SMS_API_KEY=
SMS_API_URL=
SMS_USER_ID=


# ═══ DOCKER — optional, only if your host UID is not 1000 ═══
#
# docker-compose pins the app container to this UID/GID so files written to the
# bind mount are owned by you and not root. Check yours with: id -u && id -g
HOST_UID=1000
HOST_GID=1000


# ═══ PRODUCTION ONLY ═══
#
# Set when deploying behind a proxy (Vercel, nginx), or NextAuth rejects the
# callback host. Not needed locally.
# AUTH_TRUST_HOST=true
